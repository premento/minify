{
    "name": "premento/minify",
    "type": "library",
    "description": "CSS, JavaScript & HTML minifier, in PHP. Removes whitespace, strips comments, combines files (incl. @import statements and small assets in CSS files), and optimizes/shortens a few common programming patterns.",
    "keywords": [
        "minify",
        "minifier",
        "css",
        "js",
        "javascript",
        "html"
    ],
    "homepage": "https://github.com/premento/minify",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthias Mullie",
            "homepage": "https://www.mullie.eu",
            "email": "minify@mullie.eu",
            "role": "Developer"
        },
        {
            "name": "Premento",
            "homepage": "https://premento.com",
            "email": "inbox@premento.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=5.3.0",
        "ext-pcre": "*",
        "matthiasmullie/path-converter": "~1.1",
        "psr/cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": ">=2.0",
        "matthiasmullie/scrapbook": ">=1.3",
        "phpunit/phpunit": ">=4.8"
    },
    "suggest": {
        "psr/cache-implementation": "Cache implementation to use with Minify::cache"
    },
    "autoload": {
        "psr-4": {
            "Premento\\Minify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Premento\\Minify\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/minifycss",
        "bin/minifyjs",
        "bin/minifyhtml"
    ]
}